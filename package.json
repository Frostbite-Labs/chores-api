{
  "name": "@chore-club/api",
  "version": "0.1.0",
  "private": true,
  "description": "Chore Club backend - multi-user, multi-household, multi-device service.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx scripts/gen-openapi.ts && cp ../docs/openapi.yaml ../../chore-list/docs/openapi.yaml"
  },
  "dependencies": {
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "kysely": "^0.27.0",
    "mysql2": "^3.9.0",
    "pino": "^8.17.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "js-yaml": "^4.1.1",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "zod-to-json-schema": "^3.25.2"
  }
}