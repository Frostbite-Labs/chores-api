# Chore Club API - environment template.
# config/env.ts validates presence and shape on boot; missing values fail-fast.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL (driver: mysql2). utf8mb4_0900_ai_ci, InnoDB, MySQL 8.0+.
DB_URL=mysql://root:root@127.0.0.1:3306/chore_club

# Redis (rate-limit + apple nonces).
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing secret (HS256). Must be >= 32 random bytes (base64).
JWT_ACCESS_SECRET=change-me-to-a-32-byte-random-secret

# OAuth providers - both individually optional. At least one provider must be
# fully configured; the server fail-fasts at boot if neither is. Apple is
# all-or-nothing across its four vars.

# OAuth - Google. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# OAuth - Apple. APPLE_PRIVATE_KEY is a PEM (literal newlines or \n-escaped).
# Leave all four blank to disable Apple sign-in.
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
