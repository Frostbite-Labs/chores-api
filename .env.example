# Compose env template — copy to .env (local) or .env.live (production).
#
#   cp .env.example .env          # for docker-compose.local.yml
#   cp .env.example .env.live     # for docker-compose.live.yml --env-file .env.live
#
# `docker compose` auto-loads .env from the project directory; pass
# `--env-file <path>` to point at a different file.

# ─── Host port bindings ─────────────────────────────────────────────────────
# Only the host side of the mapping; container ports are fixed.
API_PORT=3000
MYSQL_PORT=3306        # local only
REDIS_PORT=6379        # local only

# ─── Image (live only) ──────────────────────────────────────────────────────
IMAGE_REPOSITORY=chore-club-api
IMAGE_TAG=latest

# ─── API runtime (live only — local has dummy defaults baked in) ────────────
# api/src/config/env.ts validates these on boot; see api/.env.example for the
# full list and shape requirements.
LOG_LEVEL=info
DB_URL=mysql://user:pass@db.host:3306/chore_club
REDIS_URL=redis://redis.host:6379/0
JWT_ACCESS_SECRET=replace-with-32-bytes-of-random-base64
GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
